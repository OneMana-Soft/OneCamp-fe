# OneCamp frontend: build-time configuration.
#
# THESE ARE PLACEHOLDERS. Every value below is a stand-in, and the URLs point at
# a domain that does not exist. That is deliberate: a build made from a fresh
# clone should fail to reach a server rather than silently reach somebody else's.
#
# YOU DO NOT NEED TO EDIT THIS FILE. Run:
#
#     pnpm configure
#
# and answer one question. It writes `.env.production.local`, which Next.js loads
# *after* this file and which therefore wins, and which is git-ignored so your
# real domains never end up in a commit. Editing this file directly also works;
# the setup script is only there to save you the typing.
#
# Anything exported in the real environment beats both files, which is how you
# configure a Docker or CI build: pass the variables and leave the files alone.
#
# Everything here is NEXT_PUBLIC_, meaning it is compiled into the JavaScript the
# browser downloads. Do not put a secret in this file. Nothing here is one: these
# are addresses and public client identifiers. Real secrets live in the backend's
# own .env, which is never shipped to a browser.

# ── Where this workspace lives ────────────────────────────────────────────────
# Replace your-domain.com throughout with the domain you pointed at your server.
# All four are required. The backend URL is validated at build time, so a
# malformed value fails the build instead of a page load.
NEXT_PUBLIC_BACKEND_URL=https://onecamp-backend.your-domain.com/
NEXT_PUBLIC_FRONTEND_URL=https://onecamp.your-domain.com/
NEXT_PUBLIC_APP_URL=https://onecamp.your-domain.com/
NEXT_PUBLIC_LIVEKIT_URL=https://onecamp-livekit.your-domain.com
NEXT_PUBLIC_COLLABORATION_URL=wss://onecamp-collab.your-domain.com
NEXT_PUBLIC_MQTT_HOST=onecamp-emqx.your-domain.com

# Where uploaded files (avatars, attachments, image previews) are served from.
# LEAVE THIS UNSET for a stock install: it is derived from the backend host, which
# the backend's compose file places next to the object store as
# onecamp-minio.<your-domain>. Set it only if you moved the object store
# somewhere that does not follow that pattern. It feeds two allowlists, the image
# optimiser and the Content-Security-Policy, and a wrong value shows up as
# avatars and attachments that will not load.
# NEXT_PUBLIC_MINIO_URL=https://onecamp-minio.your-domain.com

# Shown in the browser tab and on the sign-in screen.
NEXT_PUBLIC_ORG_NAME=OneCamp

# Adds a "try it without an account" button to the sign-in screen. That is for a
# public demo, not for a workspace with real people in it. Leave it false.
NEXT_PUBLIC_DEMO_MODE=false

# ── Sign-in methods ───────────────────────────────────────────────────────────
# These are build-time DEFAULTS only. The running backend answers /auth/providers
# and that answer is what the sign-in screen actually renders, so an admin can
# turn a provider on or off in Settings without rebuilding the frontend. Set them
# here only to control what the very first page paint shows before that call
# returns.
NEXT_PUBLIC_AUTH_GOOGLE=true
NEXT_PUBLIC_AUTH_GITHUB=true
NEXT_PUBLIC_AUTH_EMAIL=true

# ── Push notifications (optional, off by default) ─────────────────────────────
# Browser push needs a Firebase Cloud Messaging project, and it has to be YOUR
# project: the token a browser mints is only redeemable by the project that
# issued it, so pointing this at somebody else's would register your users'
# devices somewhere you cannot send to.
#
# Left empty on purpose. The app checks these before initialising Firebase, so
# empty means push is cleanly disabled and everything else works normally. Fill
# all six in and it turns itself on. Half-filling is the one bad state: a
# plausible-looking wrong value passes the check and then fails later, in the
# browser, where you are not looking.
#
# The values come from Firebase console → Project settings → Your apps → Web app.
# They are public client identifiers, not credentials; they are safe to commit
# and are visible in the shipped bundle either way.
#
#   NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy...."
#   NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
#   NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
#   NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
#   NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
#
# VAPID key: Cloud Messaging tab → Web Push certificates → Key pair.
#   NEXT_PUBLIC_FIREBASE_VAPID_KEY="B...."
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
