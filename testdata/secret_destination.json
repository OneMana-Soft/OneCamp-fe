{
  "about": "The shared case list for a stored secret's destination. It is mirrored in the other repo (backend helpers/testdata/secret_destination.json, web testdata/secret_destination.json), and the two copies must stay byte-identical: the server and the form must agree on when a secret has to be entered again.",
  "cases": [
    {
      "why": "nothing changed",
      "from": "https://api.example.com/mcp/",
      "to": "https://api.example.com/mcp/",
      "moves": false
    },
    {
      "why": "another path on the same origin",
      "from": "https://api.example.com/mcp/",
      "to": "https://api.example.com/v2/mcp",
      "moves": false
    },
    {
      "why": "the default port written out",
      "from": "https://api.example.com/mcp",
      "to": "https://api.example.com:443/mcp",
      "moves": false
    },
    {
      "why": "the host's case and a trailing dot",
      "from": "https://API.Example.com/mcp",
      "to": "https://api.example.com./mcp",
      "moves": false
    },
    {
      "why": "a query on the same origin",
      "from": "https://api.example.com/mcp",
      "to": "https://api.example.com/mcp?x=1",
      "moves": false
    },
    {
      "why": "another host",
      "from": "https://api.example.com/mcp",
      "to": "https://evil.example.net/mcp",
      "moves": true
    },
    {
      "why": "a subdomain is another host",
      "from": "https://example.com/mcp",
      "to": "https://api.example.com/mcp",
      "moves": true
    },
    {
      "why": "https to http",
      "from": "https://api.example.com/mcp",
      "to": "http://api.example.com/mcp",
      "moves": true
    },
    {
      "why": "another port",
      "from": "https://api.example.com/mcp",
      "to": "https://api.example.com:8443/mcp",
      "moves": true
    },
    {
      "why": "user info hides another host",
      "from": "https://api.example.com/mcp",
      "to": "https://api.example.com@evil.example.net/mcp",
      "moves": true
    },
    {
      "why": "an address that doesn't parse",
      "from": "https://api.example.com/mcp",
      "to": "not a url",
      "moves": true
    },
    {
      "why": "the same address attached another way",
      "from": "https://api.example.com/mcp",
      "to": "https://api.example.com/mcp",
      "fromHow": [
        "bearer",
        ""
      ],
      "toHow": [
        "header",
        "X-Api-Key"
      ],
      "moves": true
    },
    {
      "why": "another header name",
      "from": "https://api.example.com/mcp",
      "to": "https://api.example.com/mcp",
      "fromHow": [
        "header",
        "X-Api-Key"
      ],
      "toHow": [
        "header",
        "X-Other"
      ],
      "moves": true
    },
    {
      "why": "a header name's case",
      "from": "https://api.example.com/mcp",
      "to": "https://api.example.com/mcp",
      "fromHow": [
        "header",
        "X-Api-Key"
      ],
      "toHow": [
        "header",
        "x-api-key"
      ],
      "moves": false
    },
    {
      "why": "the built-in address on both sides",
      "from": "",
      "to": "",
      "fromHow": [
        "tavily"
      ],
      "toHow": [
        "tavily"
      ],
      "moves": false
    },
    {
      "why": "another provider at the built-in address",
      "from": "",
      "to": "",
      "fromHow": [
        "tavily"
      ],
      "toHow": [
        "brave"
      ],
      "moves": true
    },
    {
      "why": "an address where there was none",
      "from": "",
      "to": "https://search.example.net",
      "fromHow": [
        "searxng"
      ],
      "toHow": [
        "searxng"
      ],
      "moves": true
    }
  ]
}
